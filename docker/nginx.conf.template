server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the resource container again after Compose restarts it.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $resource_service "${NEOS_RESOURCE_URL}";

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /neos-assets/ {
        try_files $uri =404;
    }

    location /api/resources/ {
        proxy_pass $resource_service$request_uri;
        proxy_set_header Host $http_host;
        proxy_read_timeout 120s;
        proxy_ssl_server_name on;
    }

    location /local-resources/ {
        proxy_pass $resource_service$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Neos-Accel "";
        proxy_read_timeout 120s;
        proxy_ssl_server_name on;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
