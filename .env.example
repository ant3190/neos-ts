# Downloaded card data lives OUTSIDE the Git repository.
# Relative paths resolve from this project; an absolute path can use another disk.
# Required: choose a directory, for example /mnt/data/neos-data.
# Point to the directory containing files/ and state.sqlite to reuse existing data.
NEOS_RESOURCE_DATA_DIR=
NEOS_RESOURCE_CONCURRENCY=6
NEOS_RESOURCE_AUTO_SYNC=1
NEOS_RESOURCE_OFFLINE=0
NEOS_PORT=18080
