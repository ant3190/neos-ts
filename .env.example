# First-run storage setup happens in the webpage; no .env file is required.
# Optional Docker host mounts, only needed to use another disk.
# NEOS_RESOURCE_DATA_DIR=/mnt/data/neos-data
# NEOS_RESOURCE_CONFIG_DIR=/mnt/data/neos-config
NEOS_RESOURCE_CONCURRENCY=6
NEOS_RESOURCE_AUTO_SYNC=1
NEOS_RESOURCE_OFFLINE=0
NEOS_PORT=18080
